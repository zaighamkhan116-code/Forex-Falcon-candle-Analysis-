# Set this in Railway Variables. Never commit your real key.
TWELVE_DATA_API_KEY=replace_me

# Optional overrides. The Railway start script launches the shadow service locally,
# so SHADOW_MODEL_URL does not need to be set for the standard deployment.
SHADOW_MODEL_URL=http://127.0.0.1:8001
SHADOW_MODEL_TIMEOUT_MS=5000
# Optional: point to an exact frozen bundle when one becomes available.
# SHADOW_MODEL_BUNDLE=ml_shadow/models/model_bundle.joblib
